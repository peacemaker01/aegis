+ALLOWED_RISK_LABELS = {
+    "INSTANT RUG – UNSWAPPABLE",
+    "EXTREME RISK – LIKELY RUG",
+    "EXTREME RISK – TOKENOMICS RUG",
+    "HIGH RISK – DEGEN GAMBLE",
