TELEGRAM_BOT_TOKEN="your_bot_token_here"

# OpenRouter — 3 free accounts
OPENROUTER_API_KEY=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
OPENROUTER_MODEL="deepseek/deepseek-r1"

# Etherscan — 3 free accounts
ETHERSCAN_API_KEY=key1,key2,key3

# Birdeye — 2 free accounts
BIRDEYE_API_KEY=key1,key2

# Helius — 2 free accounts
HELIUS_API_KEY=key1,key2

# Solsniffer — 2 free accounts
SOLSNIFFER_API_KEY=key1,key2

# Cryptomus Payment Gateway
CRYPTOMUS_MERCHANT_ID="your_merchant_id"
CRYPTOMUS_PAYMENT_KEY="your_payment_key"

# Subscription Pricing (defaults: $79/month, $699/year)
SUBSCRIPTION_PRICE_MONTHLY="79"
SUBSCRIPTION_PRICE_YEARLY="699"
TRIAL_DAYS="3"
